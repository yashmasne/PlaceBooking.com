# ===================================================
# PlaceBooking Server Environment Configuration
# ===================================================

# Port to listen on (Default: 8000)
PORT=8000

# Environment mode: development | production
NODE_ENV=development

# URL(s) of the frontend client for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Base URL of the backend (used for local image URLs)
SERVER_URL=http://localhost:8000

# JWT secret key for signing authentication cookies
JWT_SECRET=placebooking-local-demo-secret-change-me

# Optional: MongoDB connection (leave USE_MONGO=false for zero-setup local JSON database)
USE_MONGO=false
MONGO_URL=mongodb://127.0.0.1:27017/placebooking

# Optional: Cloudinary credentials (leave empty to store uploaded images locally in Server/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway Configuration (Razorpay - India)
# Leave empty to use the built-in interactive demo payment simulator (supports UPI, Card, Net Banking, Wallets)
PAYMENT_PROVIDER_KEY_ID=
PAYMENT_PROVIDER_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Legacy alias fallback (also supported)
KEY_ID=
KEY_SECRET=

